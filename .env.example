# Copy to .env.local. Never commit real values. Server-only unless prefixed NEXT_PUBLIC_.
# AI explanations (server-only). Unset AI_BASE_URL = mock explanations.
# Local on-device model: `wally serve qwen3-4b-instruct-2507` → http://127.0.0.1:8080/v1
AI_BASE_URL=
AI_MODEL=qwen3-4b-instruct-2507
# CPU-only local models are slow (~8 tok/s); raise this so live explanations finish
AI_TIMEOUT_MS=20000
# Only needed for hosted OpenAI-compatible endpoints
AI_API_KEY=
# Supabase (optional, not wired yet)
NEXT_PUBLIC_SUPABASE_URL=https://bbvapuwrcvbrzqghwwyo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform (server-only; used for venue lookups, travel times, accessibility).
# Enable Places API (New) + Routes API. Create key at https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=
# Restrict to Places + Routes APIs, no NEXT_PUBLIC_ prefix.

# Uber Estimates API (optional). Server-to-server token with price_estimates scope.
# Without it, rideshare still works via deep links (no key needed).
UBER_API_TOKEN=

# Google Calendar (OAuth, server-only). For "Add to my calendar" on plan items.
# Google Cloud Console → OAuth consent screen → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI must match what you register: http://localhost:3000/api/auth/google/callback
