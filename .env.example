# Copy to .env.local. Never commit real values. Server-only unless prefixed NEXT_PUBLIC_.
# AI explanations (server-only). Unset AI_BASE_URL = mock explanations.
# Local on-device model: `wally serve qwen3-4b-instruct-2507` → http://127.0.0.1:8080/v1
AI_BASE_URL=
AI_MODEL=qwen3-4b-instruct-2507
# CPU-only local models are slow (~8 tok/s); raise this so live explanations finish
AI_TIMEOUT_MS=20000
# Only needed for hosted OpenAI-compatible endpoints
AI_API_KEY=
# --- Supabase / cloud persistence (all optional locally; unset = in-memory store, no auth) ---
# Server-only: project API URL used by API routes (set together with SUPABASE_SECRET_KEY to enable cloud mode).
SUPABASE_URL=
# Server-only SECRET (sb_secret_... / service_role). NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SECRET_KEY=
# Browser-safe: same project URL, used by the client for anonymous sign-in.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable key (sb_publishable_... / anon). Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# --- Demo provider-event endpoint (simulated RSVPs/ride confirmations) ---
# Without Supabase: "1" = local `next start` demo (in-memory coordination + events endpoint open); unset = prod 503.
# With Supabase configured, production always answers 403 on events regardless. Never set on Vercel.
DAYBRIDGE_DEMO_EVENTS=
# --- Share snapshots ---
# Durable store = Supabase table share_snapshots (uses SUPABASE_URL/SUPABASE_SECRET_KEY above); otherwise in-memory.
# "memory" forces the in-memory store in production (local `next start` demo only; never set on Vercel).
SHARE_STORE=
