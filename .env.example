# DayBridge environment template. Full guide: docs/integrations/ENV_SETUP.md
#
# Setup:
#   bash:        cp .env.example .env.local
#   PowerShell:  Copy-Item .env.example .env.local
# Then restart the dev server (`npm run dev`) — Next.js reads env files only at startup.
# Copy to .env.local. Never commit real values. Server-only unless prefixed NEXT_PUBLIC_.
# NEVER commit .env.local (gitignored via `.env*`; only .env.example is tracked).
# NEXT_PUBLIC_* values are bundled into browser JS — never put a secret behind that prefix.
#
# Status legend:
#   REQUIRED     needed for the feature to work at all (nothing is required for the mock demo)
#   OPTIONAL     implemented; empty = safe default
#   EXPERIMENTAL implemented on an unmerged branch only; not approved for production
#   PROPOSED     no code reads it; documented for planning only
#
# Minimal local demo: leave EVERYTHING empty. Mock data + labeled mock explanations.

# ---------------------------------------------------------------------------
# AI / RunAnywhere — OPTIONAL, on main (src/lib/ai/adapter.ts, src/lib/ai/intake/intake.ts)
# ---------------------------------------------------------------------------
# AI explanations (server-only). Unset AI_BASE_URL = mock explanations (labeled as mock).
# Local on-device model: `wally serve qwen3-4b-instruct-2507` → http://127.0.0.1:8080/v1
# Hosted RunAnywhere (OpenAI-compatible), e.g. https://inference.runanywhere.ai/v1
AI_BASE_URL=
# Local: qwen3-4b-instruct-2507. Hosted e.g.: deepseek-v4.1-flash / glm-5.3-flash / mimo-v2.6-pro
AI_MODEL=qwen3-4b-instruct-2507
# CPU-only local models are slow (~8 tok/s); raise this so live explanations finish
# (local wally on CPU takes ~25s per explanation → use 60000)
AI_TIMEOUT_MS=20000
# Only needed for hosted OpenAI-compatible endpoints.
# SERVER-ONLY SECRET; mark "Sensitive" on Vercel. Leave empty for local wally.
AI_API_KEY=

# ---------------------------------------------------------------------------
# Demo / safety flags — OPTIONAL, on main
# ---------------------------------------------------------------------------
# LOCAL DEMO ONLY. "1" enables coordination + simulated provider replies under `next start`
# (`npm run dev` already enables them). MUST NOT be set on Vercel/hosted. Default: unset.
# (src/app/api/coordination/_lib/service.ts)
DAYBRIDGE_DEMO_EVENTS=
# "memory" = in-memory share store under `next start` (local demo only; lost on restart).
# Unset in hosted production = sharing returns 503. Never set on Vercel. (src/lib/share/share.ts)
SHARE_STORE=
# VERCEL is set automatically by Vercel; never set it yourself (read only by PR #23).

# ---------------------------------------------------------------------------
# Live discovery / integrations — OPTIONAL, used by PR #11 (intg/third-party), NOT on main yet
# All default off/empty; every source falls back to seeded data and fails soft.
# NO API key needed for: UC Berkeley public events feed, Open-Meteo weather,
# Google Calendar template links, Uber/Lyft deep links.
# ---------------------------------------------------------------------------
# "1" = enrich /api/analyze with live sources (PR #11: src/app/api/analyze/route.ts)
DAYBRIDGE_ENRICH=
# "1" = fetch Luma public events (PR #11: src/lib/integrations/luma.ts)
DAYBRIDGE_LUMA=
# DAYBRIDGE_EVENTS — requested in PR #11 review; no code reads it yet. Leave unset.
# Google Maps Platform key, SERVER-ONLY (PR #11: src/lib/integrations/places.ts).
# Needs Places API (New) enabled, billing on, key restricted by API + referrer/IP.
GOOGLE_MAPS_API_KEY=
# JSON map of human-reviewed venue Place IDs, e.g. {"example-venue":"ChIJ_EXAMPLE_PLACE_ID"}.
# Empty = {} (no live venue lookups).
DAYBRIDGE_VENUE_PLACE_IDS=
# Uber price estimates, SERVER-ONLY (PR #11: src/lib/integrations/rideshare.ts).
# API access may be restricted; failures are soft and deep links work without it.
UBER_API_TOKEN=

# ---------------------------------------------------------------------------
# Cloud / persistence — EXPERIMENTAL: PR #23 (experiment/daybridge-cloud), NOT on main,
# NOT approved for production. Without these, hosted coordination stays 503.
# ---------------------------------------------------------------------------
# Server-only project API URL (PR #23: src/lib/supabase/server.ts)
SUPABASE_URL=
# SERVER-ONLY SECRET (sb_secret_...). NEVER prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SECRET_KEY=
# PR #23 DB tests only (src/lib/supabase/auth.db.test.ts); server-only secret.
# SUPABASE_JWT_SECRET=
# Supabase (optional, not wired on main). Browser-safe values read by PR #23 src/lib/supabase/browser.ts.
# Project URL — left empty on purpose; do not hardcode a project here.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key ONLY (sb_publishable_...). Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Communication — PROPOSED, NOT IMPLEMENTED.
# No code uses these; DayBridge sends no real messages (no email, no SMS).
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Payments — Stripe / payment execution is NOT implemented. No payment variables exist.
# ---------------------------------------------------------------------------
